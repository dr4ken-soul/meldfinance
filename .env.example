NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Supabase Dashboard > Connect > Transaction pooler.
# Use its port-6543 URI for Vercel/serverless traffic; copy the complete generated URI.
SUPABASE_DATABASE_URL=

# Firebase web app settings (Firebase Console > Project settings > General > Your apps).
# These values are public client configuration, but still belong in the build environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin service account values (Firebase Console > Project settings > Service accounts).
# Keep the private key secret. In .env, encode its line breaks as \n. Never commit real values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Phase 2 sandbox bill payments. Keep these server-side, never in VITE_ variables.
# Use VTPass sandbox credentials and a Flutterwave test secret, not live keys.
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# 32-byte random key encoded as 64 hexadecimal characters. Used to encrypt
# bill-recipient details while a checkout is pending; terminal records erase them.
PAYMENT_DATA_ENCRYPTION_KEY=
